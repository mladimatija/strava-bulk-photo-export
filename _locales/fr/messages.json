			"ok": {
				"content": "$1",
				"example": "42"
			},
			"failed": {
				"content": "$2",
				"example": "5"
			},
			"reason": {
				"content": "$3",
				"example": "HTTP 404"
			}
		}
	},
	"noPhotosFound": {
		"message": "Aucune photo trouvée dans les activités sélectionnées."
	},
	"noMediaFound": {
		"message": "Aucune photo ou vidéo trouvée dans les activités sélectionnées."
	},
	"downloadFailed": {
		"message": "Échec : $REASON$",
		"placeholders": {
			"reason": {
				"content": "$1",
				"example": "Network error"
			}
		}

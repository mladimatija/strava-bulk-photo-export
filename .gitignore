node_modules/
dist/
*.zip
.DS_Store
.vite/
.idea/

# Generated icons - regenerated by `npm run icons`
icons/icon-16.png
icons/icon-48.png
icons/icon-128.png

# Generated Ko-fi button asset - regenerated by `npm run kofi`
src/kofi-asset.ts

# Playwright test outputs (per-run; screenshots in docs/screenshots/ ARE committed)
test-results/
playwright-report/
playwright/.cache/

# Chrome Web Store promotional artwork (regenerated by `npm run promo`). The
# marquee + small tile are uploaded by hand through the Web Store dashboard
# and aren't referenced anywhere else, so we skip the binary churn in git.
# The numbered `screenshot-*.png` siblings are deliberately NOT ignored -
# README.md inlines them, so GitHub needs them in the tree to render.
docs/store/promo-*.png

# Chrome Web Store submission notes - local-only crib sheet for the developer
# console form (listing copy, permissions justification, etc.). Keep it private;
# it's not source-of-truth for anything that ships in the extension.
docs/CHROME_WEB_STORE.md
